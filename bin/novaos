#!/usr/bin/env python3
"""
NovaOS Desktop Launcher (Live Environment)
Runs the futuristic Windows 11 Neo Desktop natively in terminal/console without a browser.
"""

import sys
import os

REPO_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
if REPO_ROOT not in sys.path:
    sys.path.insert(0, REPO_ROOT)

from shell.desktop import main

if __name__ == "__main__":
    main()
