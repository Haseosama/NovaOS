# NovaOS — règles de fenêtres KWin
# Media Player Classic (mpc-qt) : toujours redimensionnable, même quand le
# lecteur fixe la taille de sa fenêtre sur celle de la vidéo.
[General]
count=1
rules=novaos-mpc-qt

[novaos-mpc-qt]
Description=Media Player Classic redimensionnable
wmclass=mpc-qt
wmclassmatch=2
wmclasscomplete=false
minsize=320,180
minsizerule=2
maxsize=32767,32767
maxsizerule=2
