# NovaOS — barre des tâches façon Windows 11 (KDE Plasma 6)
#
# Barre du bas, centrée : [espace extensible] [Menu Démarrer] [Applications épinglées]
#                        [espace extensible] [Zone de notification] [Horloge] [Bureau]
# Les deux « panelspacer » centrent le groupe Menu + applications, comme Win11.

[Containments][1][Applets][10]
immutability=1
plugin=org.kde.plasma.panelspacer

[Containments][1][Applets][11]
immutability=1
plugin=org.kde.plasma.kickoff

[Containments][1][Applets][11][Configuration][General]
icon=/usr/share/novaos/novaos-logo.svg

[Containments][1][Applets][12]
immutability=1
plugin=org.kde.plasma.taskmanager

[Containments][1][Applets][12][Configuration][General]
showLabels=false
launchers=file:///usr/share/applications/firefox-esr.desktop,file:///usr/share/applications/org.kde.dolphin.desktop,file:///usr/share/applications/org.kde.konsole.desktop,file:///usr/share/applications/systemsettings.desktop,file:///usr/share/applications/vlc.desktop

[Containments][1][Applets][13]
immutability=1
plugin=org.kde.plasma.panelspacer

[Containments][1][Applets][14]
immutability=1
plugin=org.kde.plasma.systemtray

[Containments][1][Applets][15]
immutability=1
plugin=org.kde.plasma.digitalclock

[Containments][1][Applets][15][Configuration][General]
showDate=true

[Containments][1][Applets][16]
immutability=1
plugin=org.kde.plasma.showdesktop

[Containments][1][General]
alignment=left
floating=false
height=46
hiding=none
location=bottom

[Containments][1]
plugin=org.kde.panel

# --- Bureau : fond d'écran NovaOS « Bloom » ---
[Containments][2][Wallpaper]
plugin=org.kde.plasma.image

[Containments][2][Wallpaper][General]
FillMode=1
fillMode=1
Image=/usr/share/wallpapers/NovaOS-Bloom/contents/images/1920x1080.jpg
image=/usr/share/wallpapers/NovaOS-Bloom/contents/images/1920x1080.jpg

[Containments][2][Wallpaper][org.kde.plasma.image][General]
FillMode=1
fillMode=1
Image=/usr/share/wallpapers/NovaOS-Bloom/contents/images/1920x1080.jpg
image=/usr/share/wallpapers/NovaOS-Bloom/contents/images/1920x1080.jpg

[Containments][2]
plugin=org.kde.plasma.folder
