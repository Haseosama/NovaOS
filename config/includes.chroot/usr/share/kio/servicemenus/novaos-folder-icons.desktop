[Desktop Entry]
Type=Service
MimeType=inode/directory;
Actions=novaosFolderIcons;
X-KDE-Priority=TopLevel

[Desktop Action novaosFolderIcons]
Name=Appliquer les icônes de dossiers Windows
Icon=folder-pictures
Exec=sh -c 'msg="$(/usr/local/bin/novaos-folder-icons "$@")"; notify-send -a NovaOS -i folder "Icônes de dossiers" "$msg"' _ %F
