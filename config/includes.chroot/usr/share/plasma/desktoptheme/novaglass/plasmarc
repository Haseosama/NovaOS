# NovaOS — thème Plasma « NovaGlass » : seul le fond de la barre des tâches
# change (verre translucide) ; tout le reste vient de Breeze sombre.
[Settings]
FallbackTheme=breeze-dark

[BlurBehindEffect]
enabled=true

[ContrastEffect]
enabled=true
contrast=0.9
intensity=0.85
saturation=1.9

[AdaptiveTransparency]
enabled=false
