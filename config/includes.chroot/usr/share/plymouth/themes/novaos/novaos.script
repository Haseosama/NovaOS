# NovaOS — thème Plymouth (démarrage, arrêt, saisie du mot de passe LUKS)

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

Window.SetBackgroundTopColor(0.04, 0.05, 0.10);
Window.SetBackgroundBottomColor(0.04, 0.05, 0.10);

# --- Fond hexagonal (mis à l'échelle de l'écran) ---
bg_image = Image("background.png");
bg = Sprite(bg_image.Scale(screen_w, screen_h));
bg.SetPosition(0, 0, -100);

# --- Logo NovaOS au centre ---
logo_size = Math.Int(screen_h * 0.22);
logo_image = Image("logo.png").Scale(logo_size, logo_size);
logo = Sprite(logo_image);
logo_x = Math.Int(screen_w / 2 - logo_size / 2);
logo_y = Math.Int(screen_h / 2 - logo_size / 2 - screen_h * 0.05);
logo.SetPosition(logo_x, logo_y, 10);

# --- Nom ---
title_image = Image.Text("NovaOS", 0.94, 0.94, 0.95, 1, "Sans Bold 28");
title = Sprite(title_image);
title_y = logo_y + logo_size + 18;
title.SetPosition(Math.Int(screen_w / 2 - title_image.GetWidth() / 2), title_y, 10);

# --- Barre de progression ---
track_image = Image("progress-track.png");
fill_image = Image("progress-fill.png");
bar_w = track_image.GetWidth();
bar_x = Math.Int(screen_w / 2 - bar_w / 2);
bar_y = title_y + title_image.GetHeight() + 28;
track = Sprite(track_image);
track.SetPosition(bar_x, bar_y, 10);
fill = Sprite();
fill.SetPosition(bar_x, bar_y, 11);

# Petite pulsation du logo pour un effet « vivant »
tick = 0;
fun refresh_callback () {
    tick++;
    logo.SetOpacity(0.80 + 0.20 * Math.Sin(tick / 12));
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback (duration, progress) {
    w = Math.Int(bar_w * progress);
    if (w < 6) w = 6;
    fill.SetImage(fill_image.Scale(w, fill_image.GetHeight()));
}
Plymouth.SetBootProgressFunction(progress_callback);

# --- Saisie du mot de passe (disque chiffré LUKS) ---
entry_image = Image("entry.png");
bullet_image = Image("bullet.png");
entry = Sprite();
prompt = Sprite();
bullets = [];

fun hide_password () {
    entry.SetOpacity(0);
    prompt.SetOpacity(0);
    for (i = 0; bullets[i]; i++)
        bullets[i].SetOpacity(0);
    track.SetOpacity(1);
    fill.SetOpacity(1);
}

fun display_password_callback (prompt_text, bullet_count) {
    track.SetOpacity(0);
    fill.SetOpacity(0);
    if (!prompt_text) prompt_text = "Mot de passe du disque";
    p_image = Image.Text(prompt_text, 0.80, 0.84, 0.90, 1, "Sans 14");
    prompt.SetImage(p_image);
    prompt.SetPosition(Math.Int(screen_w / 2 - p_image.GetWidth() / 2), bar_y - 6, 20);
    prompt.SetOpacity(1);
    ex = Math.Int(screen_w / 2 - entry_image.GetWidth() / 2);
    ey = bar_y + p_image.GetHeight() + 6;
    entry.SetImage(entry_image);
    entry.SetPosition(ex, ey, 20);
    entry.SetOpacity(1);
    for (i = 0; bullets[i]; i++)
        bullets[i].SetOpacity(0);
    for (i = 0; i < bullet_count && i < 24; i++) {
        if (!bullets[i]) bullets[i] = Sprite(bullet_image);
        bullets[i].SetPosition(ex + 16 + i * 14, ey + Math.Int(entry_image.GetHeight() / 2 - 6), 21);
        bullets[i].SetOpacity(1);
    }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback () {
    hide_password();
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# --- Messages (ex. « Arrêt en cours ») ---
message = Sprite();
fun message_callback (text) {
    m_image = Image.Text(text, 0.70, 0.74, 0.80, 1, "Sans 12");
    message.SetImage(m_image);
    message.SetPosition(Math.Int(screen_w / 2 - m_image.GetWidth() / 2), screen_h - 60, 20);
}
Plymouth.SetMessageFunction(message_callback);

fun quit_callback () {
    hide_password();
}
Plymouth.SetQuitFunction(quit_callback);
