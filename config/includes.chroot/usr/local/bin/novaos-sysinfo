#!/bin/sh
# NovaOS — mesure processeur / mémoire pour le widget du bureau.
# Sortie (une ligne) : <cpu %> <mémoire %> <mémoire utilisée Gio> <mémoire totale Gio>
read -r _ u1 n1 s1 i1 w1 q1 sq1 st1 _ < /proc/stat
sleep 0.5
read -r _ u2 n2 s2 i2 w2 q2 sq2 st2 _ < /proc/stat
awk -v u1="$u1" -v n1="$n1" -v s1="$s1" -v i1="$i1" -v w1="$w1" -v q1="$q1" -v sq1="$sq1" -v st1="$st1" \
    -v u2="$u2" -v n2="$n2" -v s2="$s2" -v i2="$i2" -v w2="$w2" -v q2="$q2" -v sq2="$sq2" -v st2="$st2" '
    /^MemTotal:/ { t = $2 }
    /^MemAvailable:/ { a = $2 }
    END {
        busy = (u2+n2+s2+q2+sq2+st2) - (u1+n1+s1+q1+sq1+st1)
        idle = (i2+w2) - (i1+w1)
        cpu = (busy + idle) > 0 ? 100 * busy / (busy + idle) : 0
        mem = t > 0 ? 100 * (t - a) / t : 0
        printf "%d %d %.1f %.1f\n", cpu, mem, (t - a) / 1048576, t / 1048576
    }' /proc/meminfo
