#!/bin/bash
#
# NovaOS — hook live-build : lancer et installer des programmes Windows (.exe)
#
#   • Wine 64 + 32 bits (architecture i386 ajoutée : la plupart des
#     installateurs .exe sont encore en 32 bits)
#   • winetricks (bibliothèques Windows : .NET, Visual C++, polices…)
#   • Flatpak + Flathub (Bottles, la boutique Discover)
#
# Le double-clic sur un .exe / .msi est associé à /usr/local/bin/novaos-wine-run
# (voir /etc/xdg/mimeapps.list et /usr/share/applications/novaos-wine-run.desktop).
#
set -e
export DEBIAN_FRONTEND=noninteractive

apt_retry() {
    local n
    for n in 1 2 3; do
        "$@" && return 0
        echo "[novaos] nouvel essai ($n) : $*" >&2
        sleep 5
    done
    return 1
}

# --- Multiarch i386 (Wine 32 bits) ---
dpkg --add-architecture i386
apt_retry apt-get update

# --- Wine + outils ---
apt_retry apt-get install -y \
    wine wine64 wine32:i386 libwine libwine:i386 fonts-wine \
    winetricks cabextract \
    libgl1-mesa-dri:i386 libvulkan1:i386 mesa-vulkan-drivers:i386

command -v wine >/dev/null || { echo "[novaos] ERREUR : wine absent après installation" >&2; exit 1; }

# --- Flathub (Bottles, applications de la boutique Discover) ---
if command -v flatpak >/dev/null 2>&1; then
    flatpak remote-add --system --if-not-exists flathub \
        https://dl.flathub.org/repo/flathub.flatpakrepo \
        || echo "[novaos] AVERTISSEMENT : Flathub sera ajouté au premier démarrage." >&2
fi

# --- Associations de fichiers ---
update-desktop-database -q /usr/share/applications 2>/dev/null || true
update-mime-database /usr/share/mime 2>/dev/null || true

exit 0
