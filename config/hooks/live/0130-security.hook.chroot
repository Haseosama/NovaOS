#!/bin/bash
#
# NovaOS — hook live-build : durcissement (sécurité)
#
set -e

# --- Pare-feu UFW : activé, tout entrant refusé par défaut ---
if [ -f /etc/ufw/ufw.conf ]; then
    sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
fi
ufw default deny incoming  >/dev/null 2>&1 || true
ufw default allow outgoing >/dev/null 2>&1 || true

# --- Politique de mots de passe (libpam-pwquality) ---
if [ -f /etc/security/pwquality.conf ]; then
    cat >> /etc/security/pwquality.conf <<'EOF'

# --- NovaOS : politique de mots de passe (renforcement) ---
minlen = 12
dcredit = -1
ucredit = -1
lcredit = -1
ocredit = -1
maxrepeat = 3
maxsequence = 3
maxclassrepeat = 3
usercheck = 1
usersubstr = 3
gecoscheck = 1
enforce_for_root
retry = 3
EOF
fi

# --- login.defs : durcissement des comptes ---
if [ -f /etc/login.defs ]; then
    sed -i \
        -e 's/^PASS_MAX_DAYS.*/PASS_MAX_DAYS\t90/' \
        -e 's/^PASS_MIN_DAYS.*/PASS_MIN_DAYS\t1/' \
        -e 's/^PASS_WARN_AGE.*/PASS_WARN_AGE\t14/' \
        -e 's/^LOGIN_RETRIES.*/LOGIN_RETRIES\t5/' \
        -e 's/^LOGIN_TIMEOUT.*/LOGIN_TIMEOUT\t60/' \
        -e 's/^FAIL_DELAY.*/FAIL_DELAY\t4/' \
        -e 's/^UMASK.*/UMASK\t\t027/' \
        /etc/login.defs
fi

# --- Services de sécurité au démarrage ---
systemctl set-default graphical.target 2>/dev/null || true
systemctl enable ufw.service 2>/dev/null || true
systemctl enable unattended-upgrades.service 2>/dev/null || true
systemctl enable apparmor.service 2>/dev/null || true

# --- Aucun serveur SSH installé volontairement (surface d'attaque minimale) ---

# --- sysctl noyau, coredumps, journald : déposés via includes.chroot ---
#   /etc/sysctl.d/99-novaos-hardening.conf
#   /etc/systemd/coredump.conf.d/novaos.conf
#   /etc/systemd/journald.conf.d/novaos.conf

exit 0
